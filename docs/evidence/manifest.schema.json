{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatxpt.local/schemas/evidence-manifest-v1.json",
  "title": "ChatXPT evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "resources", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "updatedAt": { "type": "string", "format": "date" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "github"],
      "properties": {
        "role": { "enum": ["role-1", "role-2", "role-3", "role-4", "role-5"] },
        "github": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "owner", "status", "requiredBy", "custody", "notes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "owner": { "$ref": "#/$defs/owner" },
        "status": { "enum": ["assigned", "owner-action-required", "ready", "blocked"] },
        "requiredBy": { "type": "string", "minLength": 1, "maxLength": 120 },
        "custody": { "enum": ["private-team-channel", "private-team-drive", "local-only"] },
        "notes": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "deviceClass", "viewport"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "deviceClass": { "enum": ["server", "desktop", "mobile", "tablet", "obs", "multi-client"] },
        "viewport": { "type": ["string", "null"], "maxLength": 40 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": { "enum": ["real", "memory", "fixture", "inspection", "unverified"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "reference", "mediaType", "privacyReviewed"],
      "properties": {
        "storage": { "enum": ["repository", "private-team-drive", "github-pr", "local-only", "none"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 240 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "privacyReviewed": { "type": "boolean" },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capturedAt",
        "owner",
        "reviewer",
        "evidenceClass",
        "result",
        "claim",
        "resourceIds",
        "surfaces",
        "source",
        "authoritativeState",
        "inputs",
        "commands",
        "artifacts",
        "limitations"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^E-[0-9]{8}-R[1-5]-[0-9]{3}$" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "owner": { "$ref": "#/$defs/owner" },
        "reviewer": { "oneOf": [{ "$ref": "#/$defs/owner" }, { "type": "null" }] },
        "evidenceClass": { "enum": ["real", "memory-backed", "fixture-only", "inspection-only", "unverified"] },
        "result": { "enum": ["passed", "failed", "partial", "planned"] },
        "claim": { "type": "string", "minLength": 1, "maxLength": 300 },
        "resourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "surfaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/surface" } },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gitCommit", "branch", "prNumber"],
          "properties": {
            "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
            "branch": { "type": "string", "minLength": 1, "maxLength": 160 },
            "prNumber": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "authoritativeState": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessionRef", "questCycleRef", "revision"],
          "properties": {
            "sessionRef": { "type": ["string", "null"], "maxLength": 80 },
            "questCycleRef": { "type": ["string", "null"], "maxLength": 80 },
            "revision": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
        "commands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    }
  }
}

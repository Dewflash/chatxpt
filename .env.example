# D-072-approved server-only OpenAI path. It remains off by default, requires
# an eligible team-owned credited key, and always retains algorithmic fallback.
CHATXPT_LLM_ENABLED=false
CHATXPT_LLM_PROVIDER_ID=openai
CHATXPT_LLM_TIMEOUT_MS=8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Leave empty for OpenAI. Alternate endpoints require a new owner decision.
OPENAI_BASE_URL=

# Accepted MVP infrastructure. Empty values must keep local fallback behaviour available.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this value with NEXT_PUBLIC_ or place it in client code.
SUPABASE_SECRET_KEY=

# Legacy Supabase projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY instead. Environment validation accepts either key
# pair, but each environment should configure only one pair.

# Twitch application and Extension values are created and held by Role 1.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EXTENSION_CLIENT_ID=
# Base64 signing secret copied from the Twitch Extension console. Server-only.
TWITCH_EXTENSION_SECRET=
# Independent 32-100 character printable-ASCII HMAC secret configured on the
# Twitch EventSub webhook subscription.
TWITCH_EVENTSUB_SECRET=

# Server-only setup secret used by the streamer-controlled OBS Browser Source
# grant route. Never prefix this value with NEXT_PUBLIC_.
CHATXPT_OBS_OVERLAY_SETUP_KEY=

# Server-only bootstrap key for short-lived, session-scoped gameplay snapshot
# ingress grants. Enter it only through the streamer setup flow; never bundle it.
CHATXPT_GAMEPLAY_INGRESS_SETUP_KEY=

# Server-only bootstrap key for the manual broadcaster session start in Studio.
# Studio exchanges it for an HttpOnly, expiring session grant; never bundle it.
CHATXPT_STUDIO_SETUP_KEY=

# Server-only HMAC secret for anonymous hosted Quest Board viewer grants.
# It preserves one private voter identity per browser without a viewer account.
CHATXPT_HOSTED_BOARD_SECRET=

NEXT_PUBLIC_APP_ENV=local

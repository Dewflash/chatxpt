# The prototype works without this key by using the deterministic mock engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Accepted MVP infrastructure. Empty values must keep local fallback behaviour available.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this value with NEXT_PUBLIC_ or place it in client code.
SUPABASE_SECRET_KEY=

# Legacy Supabase projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY instead. Environment validation accepts either key
# pair, but each environment should configure only one pair.

# Twitch application and Extension values are created and held by Role 1.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EXTENSION_CLIENT_ID=
TWITCH_EXTENSION_SECRET=

NEXT_PUBLIC_APP_ENV=local

# Local-only real OBS Virtual Camera diagnostic. The route always returns 404 in production.
CHATXPT_ENABLE_CAPTURE_DIAGNOSTIC=false

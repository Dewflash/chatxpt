# `npm run dev` fills blank local runtime defaults and generated signing secrets
# in gitignored `.env.local` without overwriting configured values.
# D-072-approved server-only OpenAI path. It remains off by default, requires
# an eligible team-owned credited key, and always retains algorithmic fallback.
CHATXPT_LLM_ENABLED=false
CHATXPT_LLM_PROVIDER_ID=openai
CHATXPT_LLM_TIMEOUT_MS=8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Leave empty for OpenAI. Alternate endpoints require a new owner decision.
OPENAI_BASE_URL=

# Accepted MVP infrastructure. Empty values must keep local fallback behaviour available.
# Set to `memory` only for an explicit local degraded-mode run. `auto` uses
# Supabase when all three values below are configured.
CHATXPT_PERSISTENCE_MODE=auto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this value with NEXT_PUBLIC_ or place it in client code.
SUPABASE_SECRET_KEY=

# Legacy Supabase projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY instead. Environment validation accepts either key
# pair, but each environment should configure only one pair.

# Twitch application and Extension values are created and held by Role 1.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EXTENSION_CLIENT_ID=
# Exact Twitch Local Test asset origin, for example https://localhost:8080.
# Hosted Test derives its origin from the Extension client ID.
TWITCH_EXTENSION_ASSET_ORIGIN=
# Base64 signing secret copied from the Twitch Extension console. Server-only.
TWITCH_EXTENSION_SECRET=
# Independent 32-100 character printable-ASCII HMAC secret used by hosted
# EventSub webhooks. Localhost automatically uses Twitch EventSub WebSockets.
TWITCH_EVENTSUB_SECRET=
# Optional override: websocket for localhost/desktop, webhook for hosted HTTPS.
# Leave blank to select WebSocket on local HTTP and webhook on hosted HTTPS.
CHATXPT_TWITCH_EVENTSUB_TRANSPORT=
# Optional encrypted localhost authorization-store path. The default is a
# gitignored, owner-only `.private/twitch-authorizations.json.enc` file.
CHATXPT_LOCAL_TWITCH_STORE_PATH=
# Deployed HTTPS origin used to build hosted OAuth and EventSub callback URLs.
# Leave blank locally to use the request origin and EventSub WebSocket transport.
CHATXPT_PUBLIC_BASE_URL=

# Server-only signing/bootstrap secret used when Studio issues an OBS Browser
# Source grant. It is never entered into or returned to the browser UI.
CHATXPT_OBS_OVERLAY_SETUP_KEY=

# Server-only signing/bootstrap key for short-lived, session-scoped gameplay
# ingress grants. Studio exchanges its HttpOnly authority; never bundle this key.
CHATXPT_GAMEPLAY_INGRESS_SETUP_KEY=

# Server-only key for the diagnostic manual start only; Twitch OAuth does not use it.
CHATXPT_STUDIO_SETUP_KEY=

# Optional dedicated signer for HttpOnly Studio session grants. When omitted,
# the server reuses the existing Twitch client secret; never bundle either value.
CHATXPT_STUDIO_SESSION_SECRET=

# Server-only HMAC secret for anonymous hosted Quest Board viewer grants.
# It preserves one private voter identity per browser without a viewer account.
CHATXPT_HOSTED_BOARD_SECRET=

NEXT_PUBLIC_APP_ENV=local
# Enables the explicitly labelled browser-local demo account gate on a hosted
# preview. Local development already enables it through NEXT_PUBLIC_APP_ENV.
NEXT_PUBLIC_CHATXPT_PREVIEW_ACCOUNT_ENABLED=false

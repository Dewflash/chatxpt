{
  "name": "chatxpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "vitest run src/core/contracts.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:orchestrator": "vitest run tests/integration/orchestrator.test.ts",
    "test:persistence": "vitest run tests/integration/environment.test.ts tests/integration/permissions.test.ts tests/integration/session-lifecycle.test.ts tests/integration/persistence.test.ts tests/integration/realtime-subscriber.test.ts tests/integration/supabase-adapters.test.ts tests/integration/supabase-migration.test.ts",
    "test:ui": "vitest run tests/integration/diagnostic-ui-harness.test.tsx",
    "test:evidence": "node --test scripts/check-evidence-manifest.test.mjs",
    "test:client-secrets": "node --test scripts/check-client-secrets.test.mjs",
    "test:deployment-health": "node --test scripts/verify-deployment-health.test.mjs",
    "test:twitch-setup": "node --test scripts/verify-twitch-setup.test.mjs",
    "verify:ui-harness": "node scripts/verify-ui-harness.mjs",
    "verify:deployment-health": "node scripts/verify-deployment-health.mjs",
    "verify:twitch-setup": "node scripts/verify-twitch-setup.mjs",
    "test:watch": "vitest",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local",
    "supabase:lint": "supabase db lint --local --level warning --fail-on error",
    "supabase:test": "supabase test db",
    "check:boundaries": "node scripts/check-role-boundaries.mjs",
    "check:evidence": "node scripts/check-evidence-manifest.mjs",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:boundaries && npm run check:evidence && npm run test:evidence && npm run test:client-secrets && npm run test:deployment-health && npm run test:twitch-setup && npm test && npm run build && npm run check:client-secrets"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "next": "16.2.12",
    "openai": "7.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tesseract.js": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "jsdom": "^26.1.0",
    "supabase": "2.111.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}

{
  "name": "chatxpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup:local": "node scripts/prepare-local-runtime.mjs",
    "predev": "npm run setup:local",
    "dev": "next dev",
    "predev:twitch": "npm run setup:local",
    "dev:twitch": "next dev --experimental-https",
    "desktop:live-director": "electron desktop/live-director/main.mjs",
    "desktop:live-director:smoke": "electron desktop/live-director/main.mjs --smoke-test",
    "desktop:package:mac": "node scripts/package-live-director-macos.mjs",
    "build": "next build",
    "prestart": "npm run setup:local",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "vitest run src/core/contracts.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:hygiene": "node --test scripts/check-repository-hygiene.test.mjs",
    "test:local-setup": "node --test scripts/prepare-local-runtime.test.mjs",
    "test:orchestrator": "vitest run tests/integration/orchestrator.test.ts",
    "test:persistence": "vitest run tests/integration/environment.test.ts tests/integration/permissions.test.ts tests/integration/session-lifecycle.test.ts tests/integration/persistence.test.ts tests/integration/realtime-subscriber.test.ts tests/integration/supabase-adapters.test.ts tests/integration/supabase-migration.test.ts",
    "test:evidence": "node --test scripts/check-evidence-manifest.test.mjs",
    "test:watch": "vitest",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke-canonical-runtime.mjs",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local",
    "supabase:lint": "supabase db lint --local --level warning --fail-on error",
    "supabase:test": "supabase test db",
    "check:boundaries": "node scripts/check-role-boundaries.mjs",
    "check:hygiene": "node scripts/check-repository-hygiene.mjs",
    "check:evidence": "node scripts/check-evidence-manifest.mjs",
    "check:demo-runbook": "node scripts/check-demo-runbook.mjs",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "test:client-secrets": "node --test scripts/check-client-secrets.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:boundaries && npm run check:hygiene && npm run test:hygiene && npm run test:local-setup && npm run check:evidence && npm run check:demo-runbook && npm run test:evidence && npm run test:client-secrets && npm test && npm run build && npm run check:client-secrets"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "next": "16.2.12",
    "openai": "7.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tesseract.js": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "electron": "^43.4.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "supabase": "2.111.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
